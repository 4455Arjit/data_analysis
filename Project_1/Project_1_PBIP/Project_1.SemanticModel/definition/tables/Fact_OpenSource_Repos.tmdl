	partition Fact_OpenSource_Repos = m
		mode: import
		source =
				let
				    Source = Json.Document(
				        Web.Contents(
				            "https://api.github.com",
				            [
				                RelativePath = "search/repositories",
				                Query = [
				                    q = "topic:ai language:typescript",
				                    sort = "stars",
				                    order = "desc",
				                    per_page = "100"
				                ],
				                Headers = [#"User-Agent" = "PowerBI-Portfolio-App"]
				            ]
				        )
				    ),
				    ItemsList = Source[items],
				    ConvertedToTable = Table.FromList(ItemsList, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    ExpandedRepos = Table.ExpandRecordColumn(
				        ConvertedToTable, "Column1",
				        {"id", "name", "full_name", "stargazers_count", "forks_count", "open_issues_count", "size", "created_at", "updated_at", "language", "owner", "license"},
				        {"RepoID", "RepoName", "FullName", "Stars", "Forks", "OpenIssues", "SizeKB", "CreatedAt", "UpdatedAt", "Language", "OwnerRecord", "LicenseRecord"}
				    ),
				    ExpandedOwner = Table.ExpandRecordColumn(ExpandedRepos, "OwnerRecord", {"login", "type"}, {"OwnerLogin", "OwnerType"}),
				    ExpandedLicense = Table.ExpandRecordColumn(ExpandedOwner, "LicenseRecord", {"spdx_id"}, {"LicenseType"}),
				    ParsedDates = Table.TransformColumns(
				        ExpandedLicense,
				        {
				            {"CreatedAt", each Date.From(DateTimeZone.FromText(_)), type date},
				            {"UpdatedAt", each Date.From(DateTimeZone.FromText(_)), type date}
				        }
				    ),
				    TypedColumns = Table.TransformColumnTypes(
				        ParsedDates,
				        {
				            {"RepoID", Int64.Type}, {"Stars", Int64.Type}, {"Forks", Int64.Type},
				            {"OpenIssues", Int64.Type}, {"SizeKB", Int64.Type}
				        }
				    ),
				    #"Filtered Rows" = Table.SelectRows(TypedColumns, each true),
				    #"Replaced Value" = Table.ReplaceValue(#"Filtered Rows",null,"Unlicensed",Replacer.ReplaceValue,{"LicenseType"}),
				    #"Inserted Age" = Table.AddColumn(#"Replaced Value", "Age", each Date.From(DateTime.LocalNow()) - [CreatedAt], type duration),
				    #"Inserted Total Days" = Table.AddColumn(#"Inserted Age", "Total Days", each Duration.TotalDays([Age]), type number),
				    #"Changed Type" = Table.TransformColumnTypes(#"Inserted Total Days",{{"Total Days", Int64.Type}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"Total Days", "RepoAgeDays"}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Renamed Columns", "PopularityTier", each if [Stars] >= 20000 then "Mega Repo 20k+)" else if [Stars] >= 5000 then "High Growth (5k–20k)" else "Emerging (<5k)"),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"Age"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Removed Columns",{"RepoID", "RepoName", "FullName", "Language", "Stars", "PopularityTier", "Forks", "CreatedAt", "UpdatedAt", "OpenIssues", "SizeKB", "OwnerLogin", "OwnerType", "LicenseType", "RepoAgeDays"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Reordered Columns",{{"RepoID", "Total Tracked Repos"}, {"OpenIssues", "Open Issues"}})
				in
				    #"Renamed Columns1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

