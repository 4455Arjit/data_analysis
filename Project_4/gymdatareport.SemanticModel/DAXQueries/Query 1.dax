Age_Group =
SWITCH(
    TRUE(),
    [Age] < 20, "0-20",
    [Age] < 40, "20-40",
    [Age] < 60, "40-60",
    [Age] < 80, "60-80",
    "80-100"
)
Weight_Group =
SWITCH(
    TRUE(),
    [Weight (kg)] < 50, "40-50",
    [Weight (kg)] < 60, "50-60",
    [Weight (kg)] < 70, "60-70",
    [Weight (kg)] < 80, "70-80",
    [Weight (kg)] < 90, "80-90",
    [Weight (kg)] < 100, "90-100",
    [Weight (kg)] < 110, "100-110",
    [Weight (kg)] < 120, "110-120",
    [Weight (kg)] < 130, "120-130",
    [Weight (kg)] < 140, "130-140",
    [Weight (kg)] < 150, "140-150",
    [Weight (kg)] < 160, "150-160",
    [Weight (kg)] < 170, "160-170",
    [Weight (kg)] < 180, "170-180",
    [Weight (kg)] < 190, "180-190",
    "190-200"
)