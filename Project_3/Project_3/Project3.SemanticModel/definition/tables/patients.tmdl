		annotation SummarizationSetBy = Automatic

	column Patient_Age =
			
			VAR EndDate = COALESCE ( patients[DEATHDATE], DATE ( 2022, 2, 5 ) )
			RETURN INT ( DATEDIFF ( patients[BIRTHDATE], EndDate, DAY ) / 365.25 )
		formatString: 0
		lineageTag: 486ba80b-7aa0-48f5-babf-59a8def8dac6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Group' =
			SWITCH (
			    TRUE (),
			    patients[Patient_Age] < 35, "18-34",
			    patients[Patient_Age] < 50, "35-49",
			    patients[Patient_Age] < 65, "50-64",
			    patients[Patient_Age] < 80, "65-79",
			    "80+"
			)
		lineageTag: 87be71e3-d367-4b63-8993-51ba632d429a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

